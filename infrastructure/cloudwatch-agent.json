{
  "agent": { "metrics_collection_interval": 60 },
  "logs": {
    "logs_collected": {
      "journald": {},
      "files": {
        "collect_list": [
          { "file_path": "/var/log/messages", "log_group_name": "/pennypal/system", "log_stream_name": "{instance_id}" }
        ]
      }
    }
  },
  "metrics": {
    "append_dimensions": { "InstanceId": "${aws:InstanceId}", "AutoScalingGroupName": "${aws:AutoScalingGroupName}" },
    "metrics_collected": {
      "mem_used_percent": { "measurement": ["mem_used_percent"] },
      "disk": { "measurement": ["used_percent"], "resources": ["/"] }
    }
  }
}
