# Local MySQL by default; for RDS only change these values (no code changes)
NODE_ENV=development
PORT=4000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=pennypal
JWT_SECRET=replace-with-long-random-string
CLIENT_ORIGIN=http://localhost:5173
# Optional on AWS: load the above from SSM Parameter Store under this prefix
SSM_PREFIX=
