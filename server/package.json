{
  "name": "pennypal-server",
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=20.6" },
  "scripts": {
    "dev": "node --env-file=.env --watch src/index.js",
    "start": "node src/index.js",
    "migrate": "node --env-file=.env src/db/migrate.js",
    "seed": "node --env-file=.env src/db/seed.js",
    "test": "node --env-file=.env --test --test-concurrency=1 src/test/*.test.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1", "cookie-parser": "^1.4.6", "cors": "^2.8.5", "express": "^4.19.2",
    "express-async-errors": "^3.1.1", "express-rate-limit": "^7.4.0", "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2", "mysql2": "^3.11.0", "zod": "^3.23.8"
  },
  "optionalDependencies": { "@aws-sdk/client-ssm": "^3.600.0" }
}
